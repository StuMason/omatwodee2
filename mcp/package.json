{
  "name": "omatwodee2-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for an omatwodee2 cluster: OAuth 2.1 for Claude, Cloudflare Access login, app-centred tools over the Kubernetes API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
